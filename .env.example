# Leave DATABASE_URL unset to run on an embedded Postgres in ./.data (no install needed).
# Set it for a real instance, e.g. the one in docker-compose.yml:
# DATABASE_URL=postgres://eventos:eventos@localhost:5432/eventos
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin

# Switch the agents on: paste an Anthropic API key here and restart. Without it, everything else still works.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Where this organisation works: what new events start with, and what Today and Activity show times in.
# APP_TIMEZONE=Asia/Kolkata
# APP_CURRENCY=INR

# The public address of this instance, used in links inside emails.
# APP_URL=https://events.example.com

# Send real email: any SMTP provider (Microsoft 365, Google Workspace, Amazon SES, SendGrid...).
# Without this, emails are printed in the Terminal window instead of being sent.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Events Team <events@example.com>

# Only on a serverless host such as Vercel: a long random string. The scheduler sends it to
# /api/cron/tick, which does the background work (email, reminders, agent runs) once a minute.
# CRON_SECRET=
